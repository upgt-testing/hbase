{
  "tests": [
    {
      "testClass": "org.apache.hadoop.hbase.fs.TestBlockReorderMultiBlocks_RestartInjected",
      "testMethod": "testHBaseCluster",
      "restartPoints": [
        {
          "position": "after_cluster_start",
          "targets": ["regionserver"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_table_create",
          "targets": ["master", "regionserver"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_wal_roll",
          "targets": ["regionserver"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_put",
          "targets": ["regionserver"],
          "modes": ["GRACEFUL", "CRASH", "DELAYED_CRASH"]
        }
      ]
    },
    {
      "testClass": "org.apache.hadoop.hbase.fs.TestBlockReorderBlockLocation_RestartInjected",
      "testMethod": "testBlockLocation",
      "restartPoints": [
        {
          "position": "after_cluster_start",
          "targets": ["regionserver"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_file_create",
          "targets": ["regionserver"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "during_block_reorder_check",
          "targets": ["regionserver"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
}
