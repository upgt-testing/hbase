        {
          "position": "after_wait_table_available",
          "targets": ["master"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_verify_sft_changed",
          "targets": ["master"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    }
  ]
